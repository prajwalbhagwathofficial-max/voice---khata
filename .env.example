# Voice Khata environment configuration
# Copy this file to .env and fill in real API keys. NEVER commit .env.

# Runtime mode (set true for offline MockSTT/MockTTS dry runs)
USE_MOCKS=false

# Gnani AI (Prisma v3.0 STT + Timbre v3.0 TTS)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_SAMPLE_RATE=48000

# Groq API (structured intent extraction ONLY — never arithmetic or query answers)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional Gemini fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Encrypted SQLite ledger storage & admin wipe protection
DATA_DIR=data
DB_ENCRYPTION_KEY=replace_with_32_byte_base64_key
ADMIN_TOKEN=replace_with_random_admin_token

# Server settings
VOICE_KHATA_HOST=127.0.0.1
VOICE_KHATA_PORT=8000
VOICE_KHATA_LOG_LEVEL=INFO
