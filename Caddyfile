# Automatic HTTPS (Let's Encrypt) + WSS reverse proxy for Voice Khata.
# Set DOMAIN in your deployment environment (e.g. khata.example.com).
# HTTPS is mandatory in production so browser getUserMedia() microphone access works.
{$DOMAIN:localhost} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }

    # WebSocket session stream (Caddy natively upgrades wss:// -> ws://)
    @ws path /ws/*
    reverse_proxy @ws app:8000 {
        flush_interval -1
    }

    # Static laptop UI & assets
    reverse_proxy app:8000
}
