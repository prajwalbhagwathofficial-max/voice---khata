{
  "name": "voice-khata",
  "version": "1.0.0",
  "description": "Voice Khata - Voice-first udhaar (credit) ledger for kirana stores. Gnani Voice Hackathon PS2.",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --watch server --watch config server/index.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.3.7",
    "@supabase/supabase-js": "^2.119.2",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "groq-sdk": "^0.8.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "fake-indexeddb": "^6.2.8",
    "nodemon": "^3.1.0"
  }
}
